<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Export compliance: the app only uses standard HTTPS (exempt), so App
       Store Connect skips the encryption questionnaire on every upload. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!-- Point SpringBoard at the AppIcon set compiled into Assets.car. actool
       normally injects this when it designates the appiconset as the target's
       app icon, but we set it explicitly so a sideloaded build always has a
       resolvable home-screen icon even if that wiring is absent. The name must
       match the appiconset (AppIcon). See docs/pitfall/34. -->
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <!-- Hold-to-talk dictation (docs/15). The recognition itself needs no
       authorization — the probe measured exactly one prompt and
       SFSpeechRecognizer.authorizationStatus() stayed notDetermined while
       transcription ran (docs/33), so NSSpeechRecognitionUsageDescription is
       deliberately absent. A missing microphone string is a hard crash on first
       access, not a refusal. These keys are merged into the app at build time,
       so a freshly generated src-tauri/gen/apple/Info.plist will not show
       them. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Reading Partner uses the microphone when you hold the bar to talk. Your speech is transcribed on this iPhone and never uploaded.</string>
  <!-- The formats the reader can open, so Files and the share sheet offer this
       app for one. Both UTIs are declared by the system, so there is no
       UTImportedTypeDeclarations to go with them: importing a type the system
       already owns only adds a second, weaker declaration of it. Viewer, not
       Editor — an opened book is copied into the library and the original is
       never written back. Alternate rank leaves Books and the PDF viewers
       ranked above us, which is what a reading companion should be. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>EPUB Book</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.idpf.epub-container</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PDF Document</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.adobe.pdf</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
