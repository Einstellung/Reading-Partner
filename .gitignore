# 依赖
node_modules/

# 构建产物
dist/
# Screen-probe builds used to diff a stylesheet or component change against
# origin/main (docs/30, 验证方法). Scratch, never committed.
dist-probe*/
build/
src-tauri/target/
src-tauri/gen/

# 密钥：BYOK 模式，API key 只存本地，绝不入库
.env
.env.*
!.env.example

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# 日志
*.log
npm-debug.log*

# Local test fixture, not shipped
/public/demo.pdf

# Poster bench output: generated images and their prompt records stay local.
# The script that makes them (scripts/poster/generate.ts) is tracked.
/scripts/poster/out/

# EmbedPDF PDFium wasm: self-hosted from node_modules, not vendored into git.
# Run scripts/copy-pdfium-wasm.sh (offline, sourced from @embedpdf/pdfium).
/public/pdfium/

# Agent worktrees and session tooling; also excluded from Tailwind's
# class scan and Vite's watcher (vite.config.ts) so agent file churn
# never reloads the user's dev session.
.claude/
.playwright-mcp/

# Legacy zotero reader build leftovers must never enter the repo
/public/reader/
